{
  "name": "dsh-update-guard",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "更新守卫：检查已装插件与新版本是否兼容，只锁定会失效的那几个；配置被重置时可还原",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-update-guard": "bin/guard.mjs"
  },
  "dsh": {
    "id": "dsh-update-guard",
    "name": "更新守卫",
    "version": "0.2.2",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
