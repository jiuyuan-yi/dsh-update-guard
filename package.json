{
  "name": "dsh-update-guard",
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "test": "node test/all.mjs"
  },
  "description": "更新守卫：检查已装插件与新版本是否兼容，只锁定会失效的那几个；配置被重置时可还原。Update guard for DeepSeek Harness plugins — pin only the ones that break on upgrade, restore config that got reset.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-update-guard": "bin/guard.mjs"
  },
  "dsh": {
    "id": "dsh-update-guard",
    "name": "更新守卫",
    "version": "0.5.3",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiuyuan-yi/dsh-update-guard.git"
  },
  "homepage": "https://github.com/jiuyuan-yi/dsh-update-guard#readme",
  "bugs": {
    "url": "https://github.com/jiuyuan-yi/dsh-update-guard/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG-0.4.0.md",
    "CHANGELOG-0.4.1.md",
    "CHANGELOG-0.4.4-verified.md",
    "CHANGELOG-0.4.5.md",
    "CHANGELOG-0.5.0.md",
    "CHANGELOG-0.5.1.md",
    "CHANGELOG-0.5.2.md",
    "CHANGELOG-0.5.3.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "update-guard",
    "plugin-compat",
    "plugin-upgrade",
    "dsh-desktop"
  ]
}
